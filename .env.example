# --- required in production -------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g;print(g())"
SECRET_KEY=dev-only-insecure-key-set-SECRET_KEY-in-production
DJANGO_DEBUG=0

# Hostnames the app is reached by, and the exact origins (with scheme) allowed to POST.
# Defaults are localhost-only, so a public deployment MUST set these.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=

# --- services ---------------------------------------------------------------
# Parakeet ASR endpoint (multipart POST, field name "file")
PARAKEET_URL=http://127.0.0.1:18771/api/transcribe
# OpenAI-compatible LLM for summaries. This is YOUR endpoint - the project ships
# no shared/default hosted service. Leave LLM_FALLBACK_URL empty to disable the fallback.
LLM_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local-model
LLM_FALLBACK_URL=
LLM_FALLBACK_MODEL=
# Celery broker / result backend
CELERY_BROKER_URL=redis://127.0.0.1:6390/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6390/1
# Set to 1 to run tasks inline (development, no worker needed)
CELERY_TASK_ALWAYS_EAGER=0
# Optional: Google Drive export via the gog CLI
GOG_BIN=/home/you/.local/bin/gog
# Optional: Postgres instead of SQLite
# DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/meeting_recorder
