# Required. Generate with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_SECURE_COOKIES=1
TRUST_X_FORWARDED_PROTO=1

# Exact hostnames and HTTPS origins; never use * in production.
ALLOWED_HOSTS=localhost,127.0.0.1,meeting.example.org
CSRF_TRUSTED_ORIGINS=https://meeting.example.org

# Bundled parakeet.cpp ASR container (OpenAI-compatible verbose JSON).
PARAKEET_URL=http://127.0.0.1:18771/v1/audio/transcriptions

# Optional OpenAI-compatible summary endpoint. Empty disables summaries.
LLM_URL=
LLM_MODEL=local-model
LLM_FALLBACK_URL=
LLM_FALLBACK_MODEL=

CELERY_BROKER_URL=redis://127.0.0.1:6390/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6390/1
CELERY_TASK_ALWAYS_EAGER=0

# Optional integrations
GOG_BIN=gog
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/meeting_recorder